DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_ORIGIN="http://localhost:5173"

# For production/cloud deployment, switch prisma/schema.prisma datasource
# provider to "postgresql" and point this at your Postgres instance, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/walkthrough?schema=public"
