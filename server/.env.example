DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_ORIGIN="http://localhost:5173"

# The public URL of the app itself, used to build links sent in emails
# (e.g. password reset). Defaults to the local dev client URL if unset.
PUBLIC_APP_URL="http://localhost:5173"

# Optional: without this set, password reset links are logged to the
# server console instead of emailed (fine for local development).
# Get a free API key at https://resend.com
# RESEND_API_KEY="re_xxxxxxxx"
